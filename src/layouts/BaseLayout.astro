---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CookieBanner from '../components/layout/CookieBanner.astro';
import { getLang, otherLang, localizePath, stripLocale } from '../i18n/utils';
import { alternateOf } from '../lib/posts';
import { org } from '../config/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = '/og-default.jpg',
  noindex = false,
  jsonLd,
} = Astro.props;

const lang = getLang(Astro.currentLocale);
const canonicalPath = stripLocale(Astro.url.pathname);

/*
 * The build emits directory-style URLs (/qui-som/index.html) and the sitemap
 * lists them with a trailing slash, but the dev server and our internal links
 * omit it. Normalising here keeps canonical, sitemap and hreflang byte-identical,
 * which is what stops Google seeing two URLs for one page.
 */
const withSlash = (p: string) => (p === '/' || p.endsWith('/') ? p : `${p}/`);
const abs = (p: string) => new URL(withSlash(p), Astro.site);

const canonical = abs(localizePath(canonicalPath, lang));
const altLang = otherLang(lang);

/*
 * The other-language URL. For ordinary pages the routes mirror each other, but
 * blog posts have different slugs per language, so `alternateOf` looks up the
 * real pair and returns undefined when there isn't one. An hreflang pointing at
 * a 404 makes Google throw away the whole cluster, so "no link" beats "a guess".
 */
const altPath = await alternateOf(Astro.url.pathname, localizePath(canonicalPath, altLang));
const altHref = altPath ? abs(altPath) : undefined;
const defaultPath = lang === 'ca' ? localizePath(canonicalPath, 'ca') : altPath;

const ogImage = new URL(image, Astro.site);

/*
 * The one hard-coded Catalan fallback used to be emitted on 20 pages, including
 * every Spanish one. Pages should pass their own; this is the last resort and it
 * is at least in the right language.
 */
const fallbackDescription = {
  ca: 'El primer supermercat cooperatiu, participatiu i sense ànim de lucre de Barcelona. Més de 1.200 productes ecològics i de proximitat al passatge d’Aragó, a l’Eixample. Obert a tothom.',
  es: 'El primer supermercado cooperativo, participativo y sin ánimo de lucro de Barcelona. Más de 1.200 productos ecológicos y de proximidad en el pasaje de Aragó, en el Eixample. Abierto a todo el mundo.',
}[lang];
const metaDescription = description || fallbackDescription;

const fullTitle = title ? `${title} · ${org.name}` : org.name;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Discovered before the stylesheet parses, which removes the flash of fallback text. -->
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/open-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    {altHref && <link rel="alternate" hreflang={lang} href={canonical} />}
    {altHref && <link rel="alternate" hreflang={altLang} href={altHref} />}
    {defaultPath && <link rel="alternate" hreflang="x-default" href={abs(defaultPath)} />}

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${org.name} — ${lang === 'ca' ? 'Actualitat' : 'Actualidad'}`}
      href={new URL(lang === 'ca' ? '/rss.xml' : '/es/rss.xml', Astro.site)}
    />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={org.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image:alt" content={org.name} />
    <!-- Networks reject SVG, so this must stay a raster image at 1200x630. -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ca' ? 'ca_ES' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Icons are cropped from the real badge by scripts/gen-social-assets.mjs. -->
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#009739" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      {lang === 'ca' ? 'Salta al contingut' : 'Saltar al contenido'}
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
