---
import { getLang, useTranslations, localizePath, stripLocale } from '../../i18n/utils';
import { mainNav, utilityNav, org } from '../../config/site';
import LangToggle from '../ui/LangToggle.astro';
import Icon from '../ui/Icon.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const current = stripLocale(Astro.url.pathname);

/** External links keep their URL; internal ones get the locale prefix. */
function hrefOf(item: { path: string; external?: boolean }) {
  return item.external ? item.path : localizePath(item.path, lang);
}
/** Anchors (/qui-som#valors) are still "on" the page they point into. */
function isActive(path: string) {
  const p = path.split('#')[0];
  return current === p || current.startsWith(p + '/');
}
const ext = (item: { external?: boolean }) =>
  item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};

/*
 * Exactly one entry is highlighted, and it is the conversion action. Two pills of
 * different colours next to each other made neither of them primary, so `highlight`
 * is now a single-use flag rather than a style anyone can opt into.
 */
/* The same single-use highlight flag drives the mobile bar CTA — see the drawer. */
const ctaItem = mainNav.find((item) => item.highlight);

const pill =
  'inline-flex items-center gap-1.5 rounded-pill bg-brand-ink px-4 py-2 text-sm font-bold text-paper transition-colors duration-[var(--duration-fast)] ease-out-soft hover:bg-brand-hover focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand/40 focus-visible:ring-offset-2';
---
<header class="site-header sticky top-0 z-40 lg:top-[-2.25rem]">
  <!-- Utility row: scrolls away, only the main bar below stays pinned -->
  <div class="hidden border-b border-line bg-paper-soft lg:block">
    <div class="container-page flex h-9 items-center justify-end gap-5 text-xs font-semibold">
      {
        utilityNav.map((item) => (
          <a href={hrefOf(item)} class="hover:text-brand-ink" {...ext(item)}>
            {t(item.key)}
          </a>
        ))
      }
      <LangToggle />
    </div>
  </div>

  <!-- Main row: what stays pinned once the utility row has scrolled off -->
  <div class="border-b border-line bg-paper/95 backdrop-blur">
    <div class="container-page relative flex h-[68px] items-center justify-between gap-4">
      <!-- Brand badge: sits in the navbar and bleeds below onto the hero -->
      <a
        href={localizePath('/', lang)}
        class="absolute left-3 top-0 z-50 block"
        aria-label={org.name}
      >
        <!-- 5 KB WebP instead of the 103 KB source PNG, which was being downloaded on
             every page to paint a 104px badge. The link already carries the name, so
             the image itself is decorative. -->
        <img
          src="/logo-104.webp"
          srcset="/logo-104.webp 1x, /logo-208.webp 2x"
          alt=""
          width="104"
          height="104"
          class="h-16 w-16 drop-shadow-md md:h-[104px] md:w-[104px]"
        />
      </a>
      <!-- Spacer reserving the badge's horizontal room so nav doesn't slide under it -->
      <div class="w-16 shrink-0 md:w-[104px]" aria-hidden="true"></div>

      <!-- Desktop nav -->
      <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
        {
          mainNav.map((item) => {
            const active = !item.external && isActive(item.path);
            const aria = active ? { 'aria-current': 'page' as const } : {};
            const cls = item.highlight
              ? pill
              : 'rounded-md px-3 py-2 text-sm font-semibold hover:text-brand-ink';
            return item.children ? (
              <div class="group relative">
                <a
                  href={hrefOf(item)}
                  class:list={[cls, 'flex items-center gap-1', !item.highlight && active && 'text-brand-ink']}
                  {...aria}
                  {...ext(item)}
                >
                  {t(item.key)}
                  <Icon name="chevron" size={14} />
                </a>
                <div
                  class="invisible absolute left-0 top-full min-w-60 translate-y-1 rounded-lg border border-line bg-paper p-2 opacity-0 shadow-lg transition-all duration-[var(--duration-fast)] ease-out-soft before:absolute before:-top-2 before:left-0 before:h-2 before:w-full before:content-[''] group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
                >
                  {item.children.map((child) => (
                    <a
                      href={localizePath(child.path, lang)}
                      class="block rounded-md px-3 py-2 text-sm font-medium hover:bg-paper-green hover:text-brand-dark"
                    >
                      {t(child.key)}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a
                href={hrefOf(item)}
                class:list={[cls, 'inline-flex items-center gap-1', !item.highlight && active && 'text-brand-ink']}
                {...aria}
                {...ext(item)}
              >
                {t(item.key)}
                {item.external && <Icon name="arrow" size={13} class="-rotate-45 opacity-60" />}
              </a>
            );
          })
        }
      </nav>

      <div class="flex items-center gap-2 lg:hidden">
        <!--
          A4 — the conversion action on a phone.

          `Fes-te sòcia` is the one thing this site is asking anyone to do, and on
          mobile it lived only inside the hamburger: a visitor had to open a menu
          to discover the goal of the page. It now sits in the bar itself, with a
          shorter label so it fits beside the language switch. Below 360px there
          is genuinely no room for four controls, so it drops out and the action
          stays reachable from the drawer.
        -->
        {
          ctaItem && (
            <a
              href={hrefOf(ctaItem)}
              class="hidden items-center whitespace-nowrap rounded-pill bg-brand-ink px-3.5 py-2 text-xs font-bold text-paper transition-colors duration-[var(--duration-fast)] ease-out-soft hover:bg-brand-hover focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand/40 min-[360px]:inline-flex sm:text-sm"
            >
              {t(ctaItem.key)}
            </a>
          )
        }

        <LangToggle />

        <!--
          Mobile menu toggle (CSS-only, no JS). The icons are direct siblings of
          the checkbox, which is what Tailwind's `peer-checked:` selector requires.

          The checkbox used to be `hidden` — display:none — which takes it out of
          the tab order entirely, and a <label> is not focusable, so there was no
          way at all to open this menu from a keyboard. `sr-only` keeps it off the
          screen while leaving it focusable and Space-toggleable, and the focus
          ring is forwarded to whichever icon is currently showing via
          `peer-focus-visible:`.

          The two labels also carried the same aria-label, so a screen reader
          announced two identically-named controls; they now say open and close.
        -->
        <input type="checkbox" id="nav-toggle" class="peer sr-only" />
        <label
          for="nav-toggle"
          class="inline-flex cursor-pointer items-center rounded-md p-2 peer-checked:hidden peer-focus-visible:outline peer-focus-visible:outline-[3px] peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand"
          aria-label={t('nav.menuOpen')}
        >
          <Icon name="menu" size={26} />
        </label>
        <label
          for="nav-toggle"
          class="hidden cursor-pointer items-center rounded-md p-2 peer-checked:inline-flex peer-focus-visible:outline peer-focus-visible:outline-[3px] peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand"
          aria-label={t('nav.menuClose')}
        >
          <Icon name="close" size={26} />
        </label>

        <!-- Mobile drawer -->
        <div
          class="invisible fixed inset-x-0 top-[68px] z-40 max-h-0 overflow-hidden border-b border-line bg-paper opacity-0 transition-all duration-200 peer-checked:visible peer-checked:max-h-[calc(100vh-68px)] peer-checked:overflow-y-auto peer-checked:opacity-100"
        >
          <nav class="container-page flex flex-col gap-1 py-4" aria-label="Mobile">
            {
              mainNav.map((item) => (
                <>
                  <a
                    href={hrefOf(item)}
                    class:list={[
                      'rounded-md px-3 py-3 text-base font-semibold hover:bg-paper-green',
                      item.highlight && 'text-brand-dark',
                    ]}
                    {...ext(item)}
                  >
                    {t(item.key)}
                  </a>
                  {item.children?.map((child) => (
                    <a
                      href={localizePath(child.path, lang)}
                      class="rounded-md px-6 py-2.5 text-sm text-ink-soft hover:bg-paper-green"
                    >
                      {t(child.key)}
                    </a>
                  ))}
                </>
              ))
            }
            <hr class="my-2 border-line" />
            {
              utilityNav.map((item) => (
                <a
                  href={hrefOf(item)}
                  class="rounded-md px-3 py-2.5 text-sm text-ink-soft hover:bg-paper-green"
                  {...ext(item)}
                >
                  {t(item.key)}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </div>
  </div>
</header>
