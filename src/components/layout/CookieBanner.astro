---
/*
 * Consent banner — rendered only when there is something to consent to.
 *
 * `analytics` in src/config/site.ts is null, so today this outputs nothing: the
 * site sets no non-essential cookies. The banner it replaces asked permission for
 * "anonymous statistics" that were never installed, and dispatched a
 * `consent:accepted` event that nothing listened for. Interrupting every visitor
 * for a choice that changes nothing is a dark pattern, not caution.
 *
 * If a cookie-based provider is ever configured, this renders again — with the
 * accept and reject buttons weighted equally, which the AEPD requires and the
 * previous version did not do.
 */
import { getLang, localizePath } from '../../i18n/utils';
import { analytics } from '../../config/site';

const lang = getLang(Astro.currentLocale);
const copy = {
  ca: {
    text: 'Fem servir galetes tècniques i, amb el teu permís, estadístiques anònimes per millorar el web.',
    accept: 'Accepta',
    reject: 'Només necessàries',
    more: 'Més informació',
    label: 'Consentiment de galetes',
  },
  es: {
    text: 'Usamos cookies técnicas y, con tu permiso, estadísticas anónimas para mejorar la web.',
    accept: 'Aceptar',
    reject: 'Solo necesarias',
    more: 'Más información',
    label: 'Consentimiento de cookies',
  },
}[lang];
---
{
  analytics && (
    <div
      id="cookie-banner"
      hidden
      role="dialog"
      aria-modal="false"
      aria-label={copy.label}
      class="fixed inset-x-3 bottom-3 z-50 mx-auto max-w-3xl rounded-lg border border-line bg-paper p-4 shadow-lg sm:flex sm:items-center sm:gap-4"
    >
      <p class="text-sm text-ink-soft">
        {copy.text}{' '}
        <a href={localizePath('/legal/cookies', lang)} class="text-brand-ink underline">
          {copy.more}
        </a>
      </p>
      {/* Equal visual weight: a prominent "accept" beside a faint "reject" is not a free choice. */}
      <div class="mt-3 flex shrink-0 gap-2 sm:mt-0">
        <button
          data-cookie="reject"
          class="rounded-pill border border-brand-ink px-4 py-2 text-sm font-bold text-brand-ink"
        >
          {copy.reject}
        </button>
        <button
          data-cookie="accept"
          class="rounded-pill border border-brand-ink bg-brand-fill px-4 py-2 text-sm font-bold text-paper"
        >
          {copy.accept}
        </button>
      </div>
    </div>
  )
}

{
  analytics && (
    <script>
      // Minimal consent memory. No third-party script loads until "accept" is stored.
      const KEY = 'fc-consent';
      const banner = document.getElementById('cookie-banner');
      if (banner && !localStorage.getItem(KEY)) banner.hidden = false;
      const close = (choice: string) => {
        localStorage.setItem(KEY, choice);
        banner!.hidden = true;
        if (choice === 'accept') document.dispatchEvent(new CustomEvent('consent:accepted'));
      };
      banner?.querySelectorAll<HTMLButtonElement>('[data-cookie]').forEach((btn) => {
        btn.addEventListener('click', () => close(btn.dataset.cookie || 'reject'));
      });
      // Escape dismisses without consenting, same as choosing "only necessary".
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && banner && !banner.hidden) close('reject');
      });
    </script>
  )
}
