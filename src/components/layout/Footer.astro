---
import { getLang, useTranslations, localizePath } from '../../i18n/utils';
import { org, social, legalLinks } from '../../config/site';
import Newsletter from './Newsletter.astro';
import OpeningHours from './OpeningHours.astro';
import Icon from '../ui/Icon.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const heading = 'mb-3 flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-brand-dark';
---
<footer class="mt-auto">
  <!-- Practical band: where we are, when we're open, how to follow us, how to subscribe -->
  <div class="border-t border-line bg-paper-soft text-ink">
    <div class="container-page grid gap-10 py-12 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <h2 class={heading}><Icon name="pin" size={16} /> {t('footer.visit')}</h2>
        <address class="space-y-2 text-sm not-italic text-ink-soft">
          <p>{org.address.street}<br />{org.address.postalCode} {org.address.locality}</p>
          <p><a href={`tel:${org.phone}`} class="hover:text-brand-ink">{org.phoneDisplay}</a></p>
          <p><a href={`mailto:${org.email}`} class="hover:text-brand-ink">{org.email}</a></p>
        </address>
        <a
          href={org.mapUrl}
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex items-center gap-2 rounded-pill px-4 py-2 text-sm font-bold ring-2 ring-ink/15 hover:text-brand-ink hover:ring-brand"
        >
          <Icon name="pin" size={16} /> {t('footer.directions')}
        </a>
      </div>

      <div>
        <h2 class={heading}><Icon name="clock" size={16} /> {t('hours.today')}</h2>
        <OpeningHours variant="stacked" class="text-ink-soft" />
        <a
          href={`${localizePath('/el-super', lang)}#horaris`}
          class="mt-4 inline-block text-sm font-bold text-brand-ink hover:underline"
        >
          {t('hours.all')} →
        </a>
      </div>

      <div>
        <h2 class={heading}>{t('footer.follow')}</h2>
        <div class="flex flex-wrap gap-2">
          {
            social.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={s.name}
                class="grid h-10 w-10 place-items-center rounded-full bg-paper text-ink ring-1 ring-line hover:bg-brand hover:text-paper"
              >
                <Icon name={s.icon as any} size={18} />
              </a>
            ))
          }
        </div>
        <p class="mt-4 max-w-xs text-sm text-ink-soft">{t('footer.rights')}</p>
      </div>

      <div>
        <h2 class={heading}><Icon name="mail" size={16} /> {t('footer.newsletter')}</h2>
        <Newsletter />
      </div>
    </div>
  </div>

  <!-- Documentation, legal and copyright -->
  <div class="bg-ink text-paper">
    <div
      class="container-page flex flex-col gap-4 py-6 text-xs text-paper/60 lg:flex-row lg:items-center lg:justify-between"
    >
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          legalLinks.map((l) => (
            <li>
              <a href={localizePath(l.path, lang)} class="hover:text-accent">
                {l.label[lang]}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex flex-col gap-1 lg:items-end">
        <p>© {year} {org.legalName}</p>
        <p class="text-paper/40">{t('footer.madeIn')}</p>
      </div>
    </div>
  </div>
</footer>
