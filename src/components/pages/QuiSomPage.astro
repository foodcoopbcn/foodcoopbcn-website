---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../sections/PageHeader.astro';
import Section from '../sections/Section.astro';
import FeatureGrid from '../sections/FeatureGrid.astro';
import CTASection from '../sections/CTASection.astro';
import { getLang, useTranslations, localizePath } from '../../i18n/utils';
import { pageCopy } from '../../lib/copy';
import type { QuiSomCopy } from '../../lib/copy-types';

import Photo from '../ui/Photo.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

/* Editor-owned: src/content/copy/{ca,es}/qui-som.yaml, edited at /keystatic.
   Figures stay as {tokens} and are substituted by pageCopy. */
const c = await pageCopy<QuiSomCopy>(lang, 'qui-som');
---
<BaseLayout title={t('nav.quisom')} description={c.intro}>
  <PageHeader eyebrow={t('nav.quisom')} title={c.title} intro={c.intro} />

  <FeatureGrid
    id="valors"
    title={c.valuesTitle}
    intro={c.valuesIntro}
    features={c.values}
    tone="paper"
    columns={4}
  />

  <Section tone="soft">
    <h2 class="mb-8 text-2xl">{c.factsTitle}</h2>
    <dl class="grid gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
      {c.facts.map((f) => (
        <div class="border-t border-line pt-3">
          <dt class="text-sm font-bold uppercase tracking-wide text-brand-ink">{f.k}</dt>
          <dd class="mt-1">{f.v}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section width="narrow" id="historia">
    <h2 class="text-2xl">{c.storyTitle}</h2>
    <div class="prose-content mt-5 text-ink-soft">
      {c.story.map((p) => <p>{p}</p>)}
    </div>
  </Section>

  <!-- Full-bleed: the assembly is the evidence behind "we decide together". -->
  <figure class="relative">
    <Photo
      src="banner-assemblea"
      alt={lang === 'ca'
        ? 'Sòcies votant amb la mà alçada durant una assemblea al supermercat'
        : 'Socias votando con la mano alzada durante una asamblea en el supermercado'}
      sizes="100vw"
      class="h-[38vh] min-h-[240px] w-full object-cover md:h-[46vh]"
    />
    <figcaption class="container-page -mt-14 relative">
      <p class="inline-block rounded-md bg-brand-dark px-4 py-2 text-sm font-semibold text-on-ink-strong">
        {lang === 'ca' ? 'Assemblea general: una sòcia, un vot.' : 'Asamblea general: una socia, un voto.'}
      </p>
    </figcaption>
  </figure>

  <FeatureGrid id="governanca" title={c.govTitle} intro={c.govIntro} features={c.circles} tone="soft" columns={4} />

  <Section>
    <h2 class="mb-8 text-2xl">{c.membersTitle}</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {c.members.map((m) => (
        <div class="rounded-lg bg-paper-green p-7">
          <h3 class="text-lg text-brand-strong">{m.title}</h3>
          <p class="mt-2 text-ink-soft">{m.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <CTASection
    title={lang === 'ca' ? 'Suma-t’hi' : 'Súmate'}
    primaryCta={{ label: t('cta.becomeMember'), href: localizePath('/fes-te-socia', lang) }}
    secondaryCta={{ label: t('nav.faqs'), href: localizePath('/faqs', lang) }}
  />
</BaseLayout>
