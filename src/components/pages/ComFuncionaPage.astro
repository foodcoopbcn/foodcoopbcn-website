---
/*
 * "How a cooperative supermarket works", in plain language.
 *
 * The rebuild had no page for the single thing a stranger does not understand:
 * that the shop is owned by the people who shop in it. Everything else on the
 * site assumes you already know. This page assumes you don't.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../sections/PageHeader.astro';
import Section from '../sections/Section.astro';
import StickySteps from '../sections/StickySteps.astro';
import CTASection from '../sections/CTASection.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { getLang, useTranslations, localizePath } from '../../i18n/utils';
import { membership as m } from '../../config/site';
import { pageCopy } from '../../lib/copy';
import type { ComFuncionaCopy } from '../../lib/copy-types';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const signup = localizePath(m.signupPath, lang);

/* Editor-owned: src/content/copy/{ca,es}/com-funciona.yaml, edited at /keystatic.
   Figures stay as {tokens} and are substituted by pageCopy. */
const c = await pageCopy<ComFuncionaCopy>(lang, 'com-funciona');

const em = (s: string) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
---
<BaseLayout title={c.eyebrow} description={c.intro}>
  <PageHeader eyebrow={c.eyebrow} title={c.title} intro={c.intro}>
    <Button href={localizePath('/el-super', lang)} size="lg" variant="primary">
      {lang === 'ca' ? 'Vine a comprar' : 'Ven a comprar'}
    </Button>
    <Button href={signup} size="lg" variant="ghost">{t('cta.becomeMember')}</Button>
  </PageHeader>

  <!--
    The three steps were a flat 3-up grid, which reads as three equal options
    rather than a sequence you move through. StickySteps holds the heading in
    place while the steps travel past it, so the order is the point. The numerals
    come from a CSS counter, so `n` is no longer typed into the copy.
  -->
  <StickySteps
    title={c.stepsTitle}
    intro={c.stepsIntro}
    steps={c.steps.map((s) => ({ icon: s.icon, title: s.t, text: s.d }))}
  />

  <Section tone="soft">
    <h2 class="mb-10 text-2xl">{c.whyTitle}</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {c.why.map((w) => (
        <div class="flex gap-4 rounded-lg bg-paper p-7 shadow-sm ring-1 ring-line">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-paper-green text-brand-ink">
            <Icon name={w.icon as any} size={22} />
          </span>
          <div>
            <h3 class="text-lg">{w.t}</h3>
            <p class="mt-2 text-ink-soft">{w.d}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section>
    <h2 class="mb-8 text-2xl">{c.compareTitle}</h2>
    <!-- Scrolls inside itself rather than pushing the page sideways on a phone. -->
    <div class="overflow-x-auto">
      <table class="w-full min-w-[36rem] border-collapse text-left">
        <thead>
          <tr>
            {c.compareHeads.map((h, i) => (
              <th
                scope="col"
                class:list={[
                  'border-b-2 border-line p-4 text-sm font-bold uppercase tracking-wide',
                  i === 2 ? 'rounded-t-lg bg-paper-green text-brand-strong' : 'text-ink-soft',
                ]}
              >
                {h}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {c.compareRows.map((r) => (
            <tr>
              <th scope="row" class="border-b border-line p-4 font-semibold">{r.a}</th>
              <td class="border-b border-line p-4 text-ink-soft">{r.b}</td>
              <td class="border-b border-line bg-paper-green/40 p-4 font-semibold text-brand-strong">{r.c}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <Section tone="green" width="narrow">
    <h2 class="text-2xl text-brand-strong">{c.modelTitle}</h2>
    <p class="mt-4 text-lg" set:html={em(c.modelText)} />
  </Section>

  <CTASection
    title={c.finalTitle}
    text={c.finalText}
    primaryCta={{ label: lang === 'ca' ? 'Horari i com arribar-hi' : 'Horario y cómo llegar', href: localizePath('/el-super', lang) }}
    secondaryCta={{ label: t('cta.becomeMember'), href: localizePath('/fes-te-socia', lang) }}
  />
</BaseLayout>
