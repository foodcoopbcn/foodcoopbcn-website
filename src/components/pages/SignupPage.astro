---
/*
 * The sign-up form — the end of the conversion funnel.
 *
 * ⚠️ TEMPORARY. The co-op runs Odoo (erp.foodcoopbcn.cat) and almost certainly has
 * a real membership form there. As soon as that URL is confirmed, point
 * `membership.signupPath` in src/config/site.ts at it and this page becomes a
 * redirect. Until then this at least captures the lead instead of opening an
 * empty mail client, which is what the page it replaced did.
 *
 * Netlify Forms detects the form from the static HTML at build time; the honeypot
 * catches naive bots. Enable Netlify's own spam filtering in the site UI too —
 * a named public form attracts spam within weeks.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../sections/PageHeader.astro';
import Section from '../sections/Section.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { getLang, useTranslations, localizePath } from '../../i18n/utils';
import { pageCopy } from '../../lib/copy';
import type { SignupCopy } from '../../lib/copy-types';
import { org } from '../../config/site';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const action = localizePath('/gracies-alta', lang);
const privacy = localizePath('/legal/privacitat', lang);

/* Editor-owned: src/content/copy/{ca,es}/signup.yaml, edited at /keystatic.
   Figures stay as {tokens} and are substituted by pageCopy. */
const c = await pageCopy<SignupCopy>(lang, 'signup');

const field =
  'w-full rounded-md border border-line bg-paper px-4 py-2.5 focus:border-brand-ink focus:outline-none focus:ring-2 focus:ring-brand/40';
---
<BaseLayout title={c.title} description={c.intro}>
  <PageHeader eyebrow={c.eyebrow} title={c.title} intro={c.intro} />

  <Section>
    <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr]">
      <form
        name="membership"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action={action}
        class="space-y-5"
      >
        <input type="hidden" name="form-name" value="membership" />
        <p class="hidden">
          <label>{lang === 'ca' ? 'No omplir' : 'No rellenar'}: <input name="bot-field" /></label>
        </p>

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="mb-1.5 block text-sm font-semibold">{c.name}</span>
            <input type="text" name="name" required autocomplete="name" class={field} />
          </label>
          <label class="block">
            <span class="mb-1.5 block text-sm font-semibold">{t('form.email')}</span>
            <input type="email" name="email" required autocomplete="email" class={field} />
          </label>
        </div>

        <label class="block">
          <span class="mb-1.5 block text-sm font-semibold">{c.phone}</span>
          <input type="tel" name="phone" autocomplete="tel" class={field} />
        </label>

        <fieldset>
          <legend class="mb-1.5 text-sm font-semibold">{c.how}</legend>
          <p class="mb-3 text-sm text-ink-soft">{c.howNote}</p>
          <div class="space-y-2">
            {c.ways.map((w, i) => (
              <label class="flex items-start gap-3 rounded-md border border-line p-3 text-sm">
                <input type="radio" name="participation" value={w.v} required={i === 0} class="mt-1" />
                <span>{w.l}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="block">
          <span class="mb-1.5 block text-sm font-semibold">{c.comments}</span>
          <textarea name="message" rows="4" class={field}></textarea>
        </label>

        <label class="flex items-start gap-3 text-sm">
          <input type="checkbox" name="consent" required class="mt-1" />
          <span>
            {c.consent} <a href={privacy} class="text-brand-ink underline">{lang === 'ca' ? 'Llegeix-la' : 'Léela'}</a>.
            <span class="block text-ink-soft">{c.consentNote}</span>
          </span>
        </label>

        <Button type="submit" size="lg">{c.submit}</Button>
      </form>

      <aside class="self-start rounded-lg bg-paper-green p-8">
        <h2 class="flex items-center gap-2 font-display text-lg font-bold text-brand-strong">
          <Icon name="check" size={18} /> {c.asideTitle}
        </h2>
        <ol class="mt-4 space-y-3 text-sm text-ink-soft">
          {c.steps.map((s, i) => (
            <li class="flex items-start gap-3">
              <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-brand-fill text-xs font-bold text-paper">
                {i + 1}
              </span>
              <span>{s}</span>
            </li>
          ))}
        </ol>
        <p class="mt-6 border-t border-brand/20 pt-5 text-sm">
          <strong class="block text-brand-strong">{c.prefer}</strong>
          <a href={`mailto:${org.email}`} class="text-brand-ink underline">{org.email}</a>
          {' · '}
          <a href={`tel:${org.phone}`} class="text-brand-ink underline">{org.phoneDisplay}</a>
        </p>
      </aside>
    </div>
  </Section>
</BaseLayout>
