---
/*
 * FAQs — grouped, and deliberately long.
 *
 * These answer the questions people actually ask at the till, and they are the
 * single highest-value page for both featured snippets and AI answer engines:
 * each answer states the fact in its first sentence, then elaborates. The
 * FAQPage JSON-LD below is generated from the same array, so it can never drift.
 *
 * Figures come from `membership` (src/config/site.ts) — never retype them.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../sections/PageHeader.astro';
import Section from '../sections/Section.astro';
import Accordion from '../ui/Accordion.astro';
import { getLang, useTranslations } from '../../i18n/utils';
import { copyTokens, fillText } from '../../lib/copy';
import { getEntry } from 'astro:content';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

/*
 * Content lives in src/content/faqs/{ca,es}/index.yaml so editors can change it
 * without touching code.
 */
const entry = await getEntry('faqs', lang);
if (!entry) throw new Error(`Missing src/content/faqs/${lang}/index.yaml`);

/*
 * Figures stay as {tokens} in the YAML and are substituted here, so a number can
 * never be typed into an answer and then drift from config. The table is shared
 * with the interior pages' copy — see src/lib/copy.ts — so the FAQs and the
 * pages cannot disagree about what a quota costs.
 */
const fill = (text: string) => fillText(text, copyTokens(lang));

const groups = entry.data.groups.map((g) => ({
  title: g.title,
  faqs: g.faqs.map((f) => ({ q: fill(f.q), a: fill(f.a) })),
}));

const all = groups.flatMap((g) => g.faqs);

/* Same array, so the rich result can never disagree with the visible page. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: all.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/* Slug for a per-question anchor, so an answer can be linked to directly. */
const slug = (s: string) =>
  s
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
    .slice(0, 60);
---
<BaseLayout
  title={lang === 'ca' ? 'Preguntes freqüents' : 'Preguntas frecuentes'}
  description={lang === 'ca'
    ? `Quant costa fer-se sòcia, quantes hores demana un torn, si cal ser sòcia per comprar-hi i la resta de dubtes freqüents sobre FoodCoop BCN.`
    : `Cuánto cuesta hacerse socia, cuántas horas pide un turno, si hay que ser socia para comprar y el resto de dudas frecuentes sobre FoodCoop BCN.`}
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow={t('nav.faqs')}
    title={lang === 'ca' ? 'Preguntes freqüents' : 'Preguntas frecuentes'}
    intro={lang === 'ca'
      ? 'Les que ens arriben més sovint, agrupades. Si no hi trobes la teva, escriu-nos.'
      : 'Las que nos llegan más a menudo, agrupadas. Si no encuentras la tuya, escríbenos.'}
  />

  <Section width="narrow">
    {groups.map((g, gi) => (
      <div class="mb-12 last:mb-0">
        <h2 class="mb-4 text-xl">{g.title}</h2>
        {g.faqs.map((f, i) => (
          <Accordion question={f.q} id={slug(f.q)} open={gi === 0 && i === 0}>
            <p>{f.a}</p>
          </Accordion>
        ))}
      </div>
    ))}
  </Section>
</BaseLayout>
