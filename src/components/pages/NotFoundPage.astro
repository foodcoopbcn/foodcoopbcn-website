---
/*
 * 404. Until now Netlify served its own unbranded English page, which is a poor
 * landing spot for the several hundred people who will arrive here from an old
 * WordPress link during the migration. Give them the shop's address, the two
 * things they were most likely looking for, and a search box.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { getLang, useTranslations, localizePath } from '../../i18n/utils';
import { pageCopy } from '../../lib/copy';
import type { NotFoundCopy } from '../../lib/copy-types';
import { org } from '../../config/site';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

/* Editor-owned: src/content/copy/{ca,es}/not-found.yaml, edited at /keystatic.
   Figures stay as {tokens} and are substituted by pageCopy. */
const c = await pageCopy<NotFoundCopy>(lang, 'not-found');
---
<BaseLayout title="404" noindex={true}>
  <section class="section">
    <div class="container-narrow text-center">
      <p class="font-display text-3xl font-extrabold text-brand-ink">404</p>
      <h1 class="mt-4 text-2xl">{c.title}</h1>
      <p class="mx-auto mt-4 max-w-md text-lg text-ink-soft">{c.text}</p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {c.links.map((l) => (
          <Button href={localizePath(l.href, lang)} variant={l.primary ? 'primary' : 'ghost'}>
            {l.label}
          </Button>
        ))}
      </div>

      <p class="mt-10 text-sm text-ink-soft">
        {c.searchLabel}:{' '}
        <a href={localizePath('/actualitat/cerca', lang)} class="font-semibold text-brand-ink underline">
          {c.searchCta}
        </a>
      </p>

      <p class="mt-10 border-t border-line pt-8 text-sm text-ink-soft">
        <strong class="block text-ink">{c.visit}</strong>
        <a href={org.mapUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-brand-ink underline">
          <Icon name="pin" size={16} /> {org.address.street}, {org.address.postalCode} {org.address.locality}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
