---
/*
 * Transparency hub.
 *
 * The site promises "transparent margins" and "decisions taken in assembly" in
 * several places and never showed the evidence. The documents existed but were
 * buried in the footer under "Documentació" and marked noindex. This page puts
 * them where a sceptical reader can find them.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../sections/PageHeader.astro';
import Section from '../sections/Section.astro';
import CTASection from '../sections/CTASection.astro';
import Icon from '../ui/Icon.astro';
import { getLang, useTranslations, localizePath } from '../../i18n/utils';
import { pageCopy } from '../../lib/copy';
import type { TransparenciaCopy } from '../../lib/copy-types';
import { org, membership as m } from '../../config/site';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

/* Editor-owned: src/content/copy/{ca,es}/transparencia.yaml, edited at /keystatic.
   Figures stay as {tokens} and are substituted by pageCopy. */
const c = await pageCopy<TransparenciaCopy>(lang, 'transparencia');
---
<BaseLayout title={c.title} description={c.intro}>
  <PageHeader eyebrow={c.eyebrow} title={c.title} intro={c.intro} />

  <Section>
    <h2 class="mb-8 text-2xl">{c.docsTitle}</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {c.docs.map((d) => (
        <div class="flex flex-col rounded-lg bg-paper p-7 shadow-sm ring-1 ring-line">
          <span class="grid h-11 w-11 place-items-center rounded-lg bg-paper-green text-brand-ink">
            <Icon name={d.icon as any} size={22} />
          </span>
          <h3 class="mt-5 text-lg">{d.t}</h3>
          <p class="mt-2 grow text-sm text-ink-soft">{d.d}</p>
          <a href={d.href} class="mt-5 inline-flex items-center gap-2 font-semibold text-brand-ink underline">
            <Icon name="arrow" size={16} class="rotate-90" /> {c.download}
          </a>
        </div>
      ))}
    </div>
  </Section>

  <Section tone="soft">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl">{c.howTitle}</h2>
        <dl class="mt-6 space-y-5">
          {c.how.map((h) => (
            <div>
              <dt class="font-display text-lg font-bold">{h.t}</dt>
              <dd class="mt-1 text-ink-soft">{h.d}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <h2 class="text-2xl">{c.moneyTitle}</h2>
        <dl class="mt-6 space-y-5">
          {c.money.map((h) => (
            <div>
              <dt class="font-display text-lg font-bold">{h.t}</dt>
              <dd class="mt-1 text-ink-soft">{h.d}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </Section>

  <!-- A tight block of citable facts: the shape LLMs and search engines extract best. -->
  <Section>
    <h2 class="mb-8 text-2xl">{c.factsTitle}</h2>
    <dl class="grid gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
      {c.facts.map((f) => (
        <div class="border-t border-line pt-3">
          <dt class="text-sm font-bold uppercase tracking-wide text-brand-ink">{f.k}</dt>
          <dd class="mt-1">{f.v}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <CTASection
    title={c.finalTitle}
    text={c.finalText}
    primaryCta={{ label: t('nav.contacte'), href: localizePath('/contacte', lang) }}
    secondaryCta={{ label: t('nav.quisom'), href: localizePath('/qui-som', lang) }}
  />
</BaseLayout>
