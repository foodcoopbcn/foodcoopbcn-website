---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../sections/PageHeader.astro';
import InfoStrip from '../sections/InfoStrip.astro';
import Section from '../sections/Section.astro';
import FeatureGrid from '../sections/FeatureGrid.astro';
import Stats from '../sections/Stats.astro';
import CTASection from '../sections/CTASection.astro';
import { hours, dayKey, formatRanges, org } from '../../config/site';
import { getLang, useTranslations, localizePath } from '../../i18n/utils';
import { pageCopy } from '../../lib/copy';
import type { ElSuperCopy } from '../../lib/copy-types';
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';
import Button from '../ui/Button.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

/* Editor-owned: src/content/copy/{ca,es}/el-super.yaml, edited at /keystatic.
   Figures stay as {tokens} and are substituted by pageCopy. */
const c = await pageCopy<ElSuperCopy>(lang, 'el-super');
---
<BaseLayout title={c.title} description={c.intro}>
  <PageHeader eyebrow={t('nav.elsuper')} title={c.heading} intro={c.intro} />
  <InfoStrip />

  <FeatureGrid features={c.features} columns={3} />

  <Section tone="green" id="espai">
    <div class="grid items-center gap-8 md:grid-cols-2">
      <div>
        <h2 class="text-2xl text-brand-strong">{c.shopTitle}</h2>
        <p class="mt-4 text-lg text-ink-soft">{c.shopText}</p>
        <Button href={org.shopUrl} class="mt-6">
          <Icon name="basket" size={18} /> {lang === 'ca' ? 'Vés a la botiga' : 'Ir a la tienda'}
        </Button>
      </div>
      <div id="horaris" class="rounded-lg bg-paper p-8 shadow-sm">
        <h3 class="mb-4 flex items-center gap-2 font-display text-lg font-bold">
          <Icon name="clock" size={18} class="text-brand-ink" /> {c.hoursTitle}
        </h3>
        <dl class="space-y-1.5 text-sm">
          {hours.map((h) => (
            <div class="flex justify-between border-b border-line py-1.5">
              <dt class="font-semibold">{t(dayKey(h.day))}</dt>
              <dd class="text-ink-soft">{formatRanges(h.ranges, t('hours.closed'))}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-4 text-sm text-ink-soft">
          <Icon name="pin" size={16} class="inline text-brand-ink" /> {org.address.street}, {org.address.postalCode} {org.address.locality}
        </p>
        <p class="mt-2 text-sm text-ink-soft">{c.transit}</p>
        <Photo
          src="facana-botiga"
          alt={lang === 'ca'
            ? 'Façana del súper al fons del passatge, amb el rètol rodó groc de FoodCoop BCN'
            : 'Fachada del súper al fondo del pasaje, con el rótulo redondo amarillo de FoodCoop BCN'}
          sizes="(min-width: 768px) 40vw, 90vw"
          class="mt-5 w-full rounded-lg object-cover"
        />
        <a
          href={org.mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-ink underline"
        >
          <Icon name="arrow" size={15} class="-rotate-45" /> {c.directions}
        </a>
      </div>
    </div>
  </Section>

  <Stats stats={[
    { value: '1.200+', label: lang === 'ca' ? 'Productes' : 'Productos' },
    { value: '240 m²', label: lang === 'ca' ? 'De súper de barri' : 'De súper de barrio' },
    { value: '24-48 h', label: lang === 'ca' ? 'Repartiment en bici' : 'Reparto en bici' },
  ]} />

  <CTASection
    title={c.visit}
    primaryCta={{ label: t('cta.becomeMember'), href: localizePath('/fes-te-socia', lang) }}
    secondaryCta={{ label: t('nav.productes'), href: localizePath('/productes', lang) }}
  />
</BaseLayout>
