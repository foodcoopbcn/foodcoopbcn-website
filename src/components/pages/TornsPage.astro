---
/*
 * Shifts and circles, in detail.
 *
 * "How many hours do I really have to give?" is the objection that stops most
 * people, and the rebuild answered it with a single repeated phrase. This page
 * exists to make the commitment concrete and to say out loud that there are two
 * ways of not doing a shift at all.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../sections/PageHeader.astro';
import Section from '../sections/Section.astro';
import CTASection from '../sections/CTASection.astro';
import Accordion from '../ui/Accordion.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';
import { getLang, useTranslations, localizePath } from '../../i18n/utils';
import { pageCopy } from '../../lib/copy';
import type { TornsCopy } from '../../lib/copy-types';
import { membership as m } from '../../config/site';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const signup = localizePath(m.signupPath, lang);

/* Editor-owned: src/content/copy/{ca,es}/torns.yaml, edited at /keystatic.
   Figures stay as {tokens} and are substituted by pageCopy. */
const c = await pageCopy<TornsCopy>(lang, 'torns');
---
<BaseLayout title={c.title} description={c.intro}>
  <PageHeader eyebrow={c.eyebrow} title={c.title} intro={c.intro}>
    <Button href={signup} size="lg" variant="primary">{t('cta.becomeMember')}</Button>
    <Button href={localizePath('/fes-te-socia/preus', lang)} size="lg" variant="ghost">{c.quotaLink}</Button>
  </PageHeader>

  <Section width="narrow">
    <h2 class="text-2xl">{c.cycleTitle}</h2>
    <p class="mt-4 text-lg text-ink-soft">{c.cycleText}</p>
    <!-- Four weeks, one of them shaded: the commitment at a glance. -->
    <ol class="mt-8 grid grid-cols-4 gap-3" aria-hidden="true">
      {[0, 1, 2, 3].map((i) => (
        <li
          class:list={[
            'rounded-lg p-4 text-center text-sm font-semibold',
            i === 0 ? 'bg-brand-fill text-paper' : 'bg-paper-soft text-muted',
          ]}
        >
          {lang === 'ca' ? 'Set.' : 'Sem.'} {i + 1}
          <span class="mt-1 block text-xs font-normal">
            {i === 0 ? `${m.shiftHours} h` : '—'}
          </span>
        </li>
      ))}
    </ol>
  </Section>

  <Section tone="soft">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <Photo
          src="torn-reposant"
          alt={lang === 'ca'
            ? 'Un soci reposant ous a la lleixa del súper'
            : 'Un socio reponiendo huevos en la estantería del súper'}
          sizes="(min-width: 1024px) 46vw, 92vw"
          class="mb-8 w-full rounded-lg object-cover shadow-sm"
        />
        <h2 class="text-2xl">{c.tasksTitle}</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {c.tasks.map((task) => (
            <li class="flex items-start gap-2.5">
              <Icon name="check" size={18} class="mt-1 shrink-0 text-brand-ink" />
              <span>{task}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 rounded-lg bg-paper p-5 text-sm text-ink-soft ring-1 ring-line">{c.tasksNote}</p>
      </div>
      <div>
        <Photo
          src="torn-caixa"
          alt={lang === 'ca'
            ? 'Un soci atenent a la caixa del supermercat'
            : 'Un socio atendiendo en la caja del supermercado'}
          sizes="(min-width: 1024px) 46vw, 92vw"
          class="mb-8 w-full rounded-lg object-cover shadow-sm"
        />
        <h2 class="text-2xl">{c.typesTitle}</h2>
        <div class="mt-6 space-y-4">
          {c.types.map((ty) => (
            <div class="flex gap-4 rounded-lg bg-paper p-6 shadow-sm ring-1 ring-line">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-paper-green text-brand-ink">
                <Icon name={ty.icon as any} size={20} />
              </span>
              <div>
                <h3 class="text-lg">{ty.t}</h3>
                <p class="mt-1.5 text-sm text-ink-soft">{ty.d}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Section>

  <Section width="narrow">
    <h2 class="mb-6 text-2xl">{c.flexTitle}</h2>
    {c.flex.map((f, i) => (
      <Accordion question={f.q} open={i === 0}>
        <p>{f.a}</p>
      </Accordion>
    ))}
  </Section>

  <Section tone="green">
    <h2 class="text-2xl text-brand-strong">{c.circlesTitle}</h2>
    <p class="mt-3 max-w-2xl text-lg">{c.circlesText}</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {c.circles.map((ci) => (
        <li class="rounded-lg bg-paper p-5">
          <h3 class="text-base text-brand-strong">{ci.t}</h3>
          <p class="mt-1 text-sm text-ink-soft">{ci.d}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section width="narrow">
    <h2 class="text-2xl">{c.quotaTitle}</h2>
    <p class="mt-4 text-lg text-ink-soft">{c.quotaText}</p>
    <div class="mt-6">
      <Button href={localizePath('/fes-te-socia/preus', lang)} variant="primary">{c.quotaLink}</Button>
    </div>
  </Section>

  <CTASection
    title={c.finalTitle}
    text={c.finalText}
    primaryCta={{ label: t('cta.becomeMember'), href: signup }}
    secondaryCta={{ label: t('nav.contacte'), href: localizePath('/contacte', lang) }}
  />
</BaseLayout>
