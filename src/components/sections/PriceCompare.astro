---
/*
 * "Compara FoodCoop BCN amb altres supermercats" — the basic basket, priced today
 * at the co-op and at four Barcelona supermarkets, from src/data/prices.json
 * (refreshed daily by scripts/fetch-prices.mjs) through buildCompareView().
 *
 * Two parts, in the order a shopper reads them:
 *
 *   1. a summary that answers "is this expensive?" in a sentence per supermarket;
 *   2. the table, product by product, for anyone who wants to check the answer.
 *
 * The summary compares one shop at a time, over the products that shop sells in
 * the same kind as ours, organic or conventional. Requiring every shop to agree
 * on that sounds fairer and is not: Mercadona stocks no organic version of ten of
 * these products, so the intersection collapses to the conventional rows and ends
 * up comparing our organic range against industrial own-brands.
 *
 * Both figures on this page come from the co-op's own shop, which publishes two
 * price lists. Nothing here applies a discount to anything: see the note at the
 * top of scripts/stores/foodcoop.mjs for why that matters.
 *
 * The member price leads throughout and the public one is a second line in the
 * table. There is deliberately no whole-basket total per shop: adding all
 * eighteen rows sets our mostly organic basket against a conventional one, which
 * is the least meaningful number the data can produce.
 *
 * No client-side JavaScript, per the no-CSR rule.
 */
import Section from './Section.astro';
import PriceCompareCell from './PriceCompareCell.astro';
import PricePairs from './PricePairs.astro';
import type { CompareView } from '../../lib/prices';
import { getLang, useTranslations } from '../../i18n/utils';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  tone?: 'paper' | 'soft' | 'green';
  data: CompareView;
  id?: string;
}
const { eyebrow, title, intro, tone = 'soft', data, id = 'compara' } = Astro.props;

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const fill = (s: string, vars: Record<string, string | number>) =>
  s.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));

const labels = {
  public: t('compare.public'),
  unavailable: t('compare.unavailable'),
  eco: t('compare.eco'),
  notEco: t('compare.notEco'),
  viewProduct: t('compare.viewProduct'),
};
const list = (items: string[]) =>
  new Intl.ListFormat(lang === 'ca' ? 'ca' : 'es', { type: 'conjunction' }).format(items);

const notes = [
  fill(t('compare.method.source'), { date: data.updatedAt }),
  t('compare.method.member'),
  t('compare.method.match'),
  t('compare.method.qty'),
  ...(data.pairs.length ? [t('compare.method.pair')] : []),
  t('compare.method.absent'),
  ...(data.hiddenStores.length ? [fill(t('compare.method.hidden'), { stores: list(data.hiddenStores) })] : []),
  ...data.stores
    .filter((s) => s.missing.length)
    .map((s) => fill(t('compare.method.missing'), { store: s.label, items: list(s.missing) })),
];
---
<Section tone={tone} id={id}>
  <div class="mx-auto mb-10 max-w-2xl text-center">
    {eyebrow && <p class="mb-3 text-sm font-bold uppercase tracking-wide text-brand-ink">{eyebrow}</p>}
    <h2 class="text-2xl">{title}</h2>
    {intro && <p class="mt-4 text-lg opacity-80">{intro}</p>}
  </div>

  {
    data.pairs.length > 0 && (
      <div class="reveal mx-auto mb-12 max-w-4xl rounded-lg bg-paper p-6 shadow-sm ring-1 ring-line sm:p-8">
        <h3 class="font-display text-lg font-bold">{t('compare.pair.title')}</h3>
        <p class="mt-1 mb-7 max-w-2xl text-sm text-ink-soft">{t('compare.pair.note')}</p>
        <PricePairs pairs={data.pairs} scale={data.pairScale} />
      </div>
    )
  }

  <h3 class="mx-auto mb-4 max-w-5xl font-display text-lg font-bold">{t('compare.table.title')}</h3>

  <!-- Desktop: one table, products down, shops across -->
  <div class="mx-auto hidden max-w-5xl overflow-hidden rounded-lg bg-paper shadow-sm ring-1 ring-line md:block">
    <table class="w-full border-collapse text-left">
      <thead>
        <tr class="border-b border-line">
          <th scope="col" class="px-5 py-4 align-bottom text-sm font-bold uppercase tracking-wide text-ink-soft">
            {t('compare.product')}
          </th>
          {
            data.stores.map((s) => (
              <th
                scope="col"
                class:list={[
                  'px-4 py-4 text-center align-bottom',
                  s.featured ? 'bg-paper-green text-brand-strong' : 'text-ink-soft',
                ]}
              >
                <span class="block text-sm font-bold uppercase tracking-wide">{s.label}</span>
                <span class="mt-1 block text-[11px] font-normal opacity-80">
                  {t('compare.updated')} {s.updatedAt}
                </span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          data.items.map((it) => (
            <tr class="border-b border-line align-top last:border-0">
              <th scope="row" class="px-5 py-4 text-sm font-semibold">
                {it.label}
                <span class="block text-xs font-normal text-muted">{it.basis}</span>
              </th>
              {it.cells.map((c, i) => (
                <td class:list={['px-4 py-4 text-center text-sm', data.stores[i].featured && 'bg-paper-green/50']}>
                  <PriceCompareCell cell={c} labels={labels} />
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
      <tfoot>
        <tr class="border-t-2 border-line bg-paper-soft align-top">
          <th scope="row" class="px-5 py-4 text-sm font-bold">
            {t('compare.total')}
            <span class="block text-xs font-normal text-muted">
              {fill(t('compare.totalNote'), { n: data.totalCount })}
            </span>
          </th>
          {
            data.stores.map((s) => (
              <td class:list={['px-4 py-4 text-center', s.featured && 'bg-paper-green/50']}>
                <span class="font-display text-xl font-extrabold tabular-nums">
                  {s.memberTotal ?? s.total ?? '—'}
                </span>
                {s.memberTotal && (
                  <span class="mt-0.5 block text-[11px] font-normal text-muted">
                    {t('compare.public')}: <span class="tabular-nums">{s.total}</span>
                  </span>
                )}
              </td>
            ))
          }
        </tr>
      </tfoot>
    </table>
  </div>

  <!-- Mobile: one card per product, so nothing scrolls sideways -->
  <div class="grid gap-4 md:hidden">
    {
      data.items.map((it) => (
        <div class="rounded-lg bg-paper p-5 shadow-sm ring-1 ring-line">
          <h4 class="text-base font-bold">
            {it.label} <span class="text-sm font-normal text-muted">· {it.basis}</span>
          </h4>
          <dl class="mt-3 divide-y divide-line">
            {it.cells.map((c, i) => (
              <div
                class:list={[
                  'flex items-start justify-between gap-4 py-2.5',
                  data.stores[i].featured && '-mx-2 rounded-sm bg-paper-green/50 px-2',
                ]}
              >
                <dt class="pt-0.5 text-sm font-semibold">{data.stores[i].label}</dt>
                <dd class="shrink-0">
                  <PriceCompareCell cell={c} align="right" labels={labels} />
                </dd>
              </div>
            ))}
          </dl>
        </div>
      ))
    }
  </div>

  <div class="mt-4 rounded-lg bg-paper-soft p-5 ring-1 ring-line md:hidden">
    <h4 class="text-sm font-bold">{t('compare.total')}</h4>
    <p class="text-xs text-muted">{fill(t('compare.totalNote'), { n: data.totalCount })}</p>
    <dl class="mt-3 divide-y divide-line">
      {
        data.stores.map((s) => (
          <div class="flex items-baseline justify-between gap-4 py-2">
            <dt class="text-sm font-semibold">{s.label}</dt>
            <dd class="text-right">
              <span class="font-display text-base font-extrabold tabular-nums">
                {s.memberTotal ?? s.total ?? '—'}
              </span>
              {s.memberTotal && (
                <span class="block text-[11px] text-muted">
                  {t('compare.public')}: <span class="tabular-nums">{s.total}</span>
                </span>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!--
    Outside the mobile grid above. It used to be nested inside it, so every
    disclosure on this page — where the prices come from, which shops are missing
    today — was invisible on desktop, which is the half of the audience most
    likely to want it.
  -->
  <div class="mx-auto mt-8 max-w-3xl text-sm text-ink-soft">
    <h3 class="text-sm font-bold uppercase tracking-wide text-ink">{t('compare.method.title')}</h3>
    <ul class="mt-2 list-disc space-y-1 pl-5">
      {notes.map((n) => <li>{n}</li>)}
    </ul>
  </div>
</Section>
