---
/*
 * One price in the comparison: the figure for the basket quantity (the member price at
 * FoodCoop, with the public price underneath), the exact product it
 * came from (linked, so anyone can check), the pack it was taken from, and an ECO badge
 * or a "no eco" mark when the FoodCoop item is organic and this one is not.
 */
import type { CompareCell } from '../../lib/prices';

interface Props {
  cell: CompareCell | null;
  align?: 'center' | 'right';
  labels: { public: string; unavailable: string; eco: string; notEco: string; viewProduct: string };
}
const { cell, align = 'center', labels } = Astro.props;
const alignCls = align === 'right' ? 'text-right items-end' : 'text-center items-center';
---
{
  cell ? (
    <div class:list={['flex flex-col', alignCls]}>
      <span class="font-display text-lg font-extrabold tabular-nums leading-tight">
        {cell.memberPrice ?? cell.price}
      </span>
      {cell.memberPrice && (
        <span class="text-xs font-semibold text-brand-dark">
          {labels.public}: <span class="tabular-nums">{cell.price}</span>
        </span>
      )}
      <a
        href={cell.url}
        target="_blank"
        rel="nofollow noopener"
        title={labels.viewProduct}
        class="mt-1 max-w-[16rem] text-xs leading-snug text-ink-soft hover:text-brand-ink hover:underline"
      >
        {cell.brand && !cell.name.toLowerCase().includes(cell.brand.toLowerCase()) ? `${cell.brand} · ` : ''}
        {cell.name}
      </a>
      <span class="mt-0.5 text-[11px] leading-snug text-muted">{cell.pack}</span>
      {cell.mark === 'eco' && (
        <span class="mt-1.5 inline-block rounded-pill bg-paper-green px-2 py-0.5 text-[11px] font-bold tracking-wide text-brand-dark">
          {labels.eco}
        </span>
      )}
      {cell.mark === 'noeco' && (
        <span class="mt-1.5 inline-block rounded-pill bg-paper-soft px-2 py-0.5 text-[11px] font-semibold tracking-wide text-muted ring-1 ring-line">
          {labels.notEco}
        </span>
      )}
    </div>
  ) : (
    <>
      <span aria-hidden="true" class="text-muted">—</span>
      <span class="sr-only">{labels.unavailable}</span>
    </>
  )
}
