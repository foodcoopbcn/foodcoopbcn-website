---
/*
 * A band of figures. Optionally icon-led, and optionally with a heading and a call to action
 * — which is what turns it into the highlight band ("72% de la fruita i verdura…").
 */
import Section from './Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  title?: string;
  stats: { value: string; label: string; icon?: string }[];
  tone?: 'paper' | 'soft' | 'green' | 'ink';
  cta?: { label: string; href: string };
}
const { title, stats, tone = 'ink', cta } = Astro.props;

/* On the dark band the accent yellow carries the figures; on light ones the brand green does. */
const valueTone = tone === 'ink' ? 'text-accent' : 'text-brand-ink';

/* Fit the grid to how many figures there are — two stats in a four-column grid collide. */
const cols =
  { 1: 'grid-cols-1', 2: 'grid-cols-2', 3: 'grid-cols-2 lg:grid-cols-3' }[stats.length] ??
  'grid-cols-2 lg:grid-cols-4';
---
<Section tone={tone}>
  <div class="flex flex-col items-center gap-8 lg:flex-row lg:justify-between">
    {title && <h2 class="max-w-md text-center text-xl lg:text-left">{title}</h2>}

    <dl class:list={['reveal-stagger grid flex-1 gap-8 text-center', cols]}>
      {stats.map((s) => (
        <div>
          {s.icon && (
            <Icon name={s.icon as any} size={28} class={`mx-auto mb-2 ${valueTone}`} />
          )}
          <dt class:list={['font-display text-3xl font-extrabold', valueTone]}>{s.value}</dt>
          <dd class="mt-1 text-sm font-semibold uppercase tracking-wide opacity-80">{s.label}</dd>
        </div>
      ))}
    </dl>

    {cta && (
      <Button href={cta.href} variant={tone === 'ink' ? 'accent' : 'ghost'}>
        {cta.label}
      </Button>
    )}
  </div>
</Section>
