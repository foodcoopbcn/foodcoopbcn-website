---
/*
 * Homepage teaser for the price comparison, which lives in full at /comparativa.
 *
 * It used to show the single product where the member price beat the other shops
 * by the widest margin. That was honest about being a favourable example and
 * still the wrong thing to lead with: today it would pick sea salt against
 * Bonpreu, and the first thing anyone who clicked through would see is that
 * Mercadona sells that same salt for less than we do. One product cannot answer
 * "is this expensive?", and picking the best one invites the reader to check
 * whether they are being handled.
 *
 * So the teaser shows the same per-shop comparison as the page: the whole basket
 * against each supermarket, member tariff, in a fixed order, including the shop
 * we lose to by 65 %. It is a weaker claim and a much more credible one.
 *
 * If the data is stale or no shop has comparable products, this renders nothing.
 * Better a missing section than a claim that has quietly expired.
 */
import Section from './Section.astro';
import Button from '../ui/Button.astro';
import PricePairs from './PricePairs.astro';
import { buildCompareView } from '../../lib/prices';
import { getLang, useTranslations, localizePath } from '../../i18n/utils';

interface Props {
  eyebrow?: string;
  title?: string;
  tone?: 'paper' | 'soft' | 'green';
}
const { eyebrow, title, tone = 'soft' } = Astro.props;

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const view = buildCompareView(lang);
const pairs = view?.pairs ?? [];
---
{
  pairs.length > 0 && (
    <Section tone={tone}>
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <p class="mb-3 text-sm font-bold uppercase tracking-wide text-brand-ink">{eyebrow || t('teaser.eyebrow')}</p>
          <h2 class="text-2xl">{title || t('teaser.title')}</h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg opacity-80">{t('teaser.intro')}</p>
        </div>

        <div class="reveal mt-8 rounded-lg bg-paper p-6 shadow-sm ring-1 ring-line sm:p-8">
          <PricePairs pairs={pairs} scale={view!.pairScale} compact />
        </div>

        <p class="mx-auto mt-6 max-w-2xl text-center text-sm text-ink-soft">{t('teaser.caveat')}</p>
        <p class="mt-2 text-center text-xs text-muted">{`${t('teaser.updated')} ${view!.updatedAt}`}</p>

        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <Button href={localizePath('/comparativa', lang)} variant="primary">
            {t('teaser.cta')}
          </Button>
          <Button href={localizePath('/fes-te-socia/preus', lang)} variant="ghost">
            {t('teaser.secondary')}
          </Button>
        </div>
      </div>
    </Section>
  )
}
