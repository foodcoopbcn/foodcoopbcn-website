---
/* Generic section wrapper — controls background tone and width. Compose pages from these. */
interface Props {
  tone?: 'paper' | 'soft' | 'green' | 'ink';
  /** Pulls this section up against the one above it. */
  tight?: boolean;
  width?: 'page' | 'narrow';
  id?: string;
  class?: string;
}
const { tone = 'paper', width = 'page', id, tight = false, class: className = '' } = Astro.props;
const tones = {
  paper: 'bg-paper text-ink',
  soft: 'bg-paper-soft text-ink',
  green: 'bg-paper-green text-brand-strong',
  /* A surface that is dark in BOTH themes, so its text comes from the on-ink
     ramp rather than from --color-paper, which flips. */
  ink: 'bg-brand-dark text-on-ink-strong',
};
const container = width === 'narrow' ? 'container-narrow' : 'container-page';
---
<section id={id} class:list={['section', tight && 'section-tight', tones[tone], className]}>
  <div class={container}>
    <slot />
  </div>
</section>
