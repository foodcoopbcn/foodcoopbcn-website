---
import Section from './Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Option {
  badge?: string;
  title: string;
  text: string;
  points?: string[];
  cta?: { label: string; href: string };
  featured?: boolean;
}
interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  options: Option[];
  tone?: 'paper' | 'soft' | 'green';
}
const { eyebrow, title, intro, options, tone = 'soft' } = Astro.props;
---
<Section tone={tone}>
  {(eyebrow || title || intro) && (
    <div class="mx-auto mb-12 max-w-2xl text-center">
      {eyebrow && <p class="mb-3 text-sm font-bold uppercase tracking-widest text-brand-ink">{eyebrow}</p>}
      {title && <h2 class="text-2xl">{title}</h2>}
      {intro && <p class="mt-4 text-lg text-ink-soft">{intro}</p>}
    </div>
  )}
  <div class="reveal-stagger grid gap-6 md:grid-cols-2">
    {options.map((o) => (
      <div
        class:list={[
          'flex flex-col rounded-lg p-8 ring-1',
          o.featured ? 'bg-paper text-ink ring-2 ring-brand shadow-md' : 'bg-paper text-ink ring-line shadow-sm',
        ]}
      >
        {o.badge && (
          <span
            class:list={[
              'mb-4 inline-flex w-fit items-center rounded-pill px-3 py-1 text-xs font-bold uppercase tracking-wide',
              o.featured ? 'bg-accent text-ink' : 'bg-paper-soft text-ink-soft',
            ]}
          >
            {o.badge}
          </span>
        )}
        <h3 class="text-xl">{o.title}</h3>
        <p class="mt-3 text-ink-soft">{o.text}</p>
        {o.points && (
          <ul class="mt-5 space-y-2.5">
            {o.points.map((p) => (
              <li class="flex items-start gap-2.5 text-sm">
                <Icon name="check" size={18} class="mt-0.5 shrink-0 text-brand-ink" />
                <span class="text-ink">{p}</span>
              </li>
            ))}
          </ul>
        )}
        {o.cta && (
          <div class="mt-7 pt-2">
            <Button href={o.cta.href} variant={o.featured ? 'primary' : 'ghost'}>{o.cta.label}</Button>
          </div>
        )}
      </div>
    ))}
  </div>
</Section>
