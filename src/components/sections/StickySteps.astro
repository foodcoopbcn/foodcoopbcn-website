---
/*
 * A numbered sequence where the heading holds still and the steps move past it.
 *
 * `position: sticky` on the left column is the whole mechanism — no observer, no
 * scroll handler, no JavaScript at all. It works in every browser that ships
 * sticky, and degrades to a plain two-column layout below the breakpoint where
 * a sticky column would have nothing to stick against.
 *
 * The steps are a real <ol>. The visible numerals come from a CSS counter rather
 * than being typed into the copy, so an editor reordering them in Keystatic
 * cannot end up with "1, 3, 2" — and a screen reader gets list semantics
 * instead of a paragraph that happens to start with a digit.
 */
import Icon from '../ui/Icon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  tone?: 'paper' | 'soft' | 'green';
  steps: { title: string; text: string; icon?: string }[];
  id?: string;
}

const { eyebrow, title, intro, tone = 'paper', steps, id } = Astro.props;

const tones = {
  paper: 'bg-paper text-ink',
  soft: 'bg-paper-soft text-ink',
  green: 'bg-paper-green text-brand-dark',
};
---
<section id={id} class:list={['section', tones[tone]]}>
  <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <!--
      The asymmetric 5/7 split is the point: the site's other grids are all
      halves or thirds, which is why every section reads at the same rhythm.
    -->
    <div class="lg:sticky lg:top-28 lg:self-start">
      {eyebrow && (
        <p class="mb-3 text-sm font-bold uppercase tracking-widest text-brand-ink">{eyebrow}</p>
      )}
      <h2 class="text-2xl">{title}</h2>
      {intro && <p class="mt-4 text-lg text-ink-soft">{intro}</p>}
    </div>

    <ol class="steps space-y-5">
      {steps.map((step) => (
        <li class="reveal relative rounded-lg bg-paper p-7 shadow-sm ring-1 ring-line">
          <!--
            The numeral sits on the same line as the title rather than above it.
            A numeral chip stacked over an icon chip reads as two badges
            competing for the same job; the number is the sequence marker, so it
            leads, and the icon is optional decoration beside the copy.
          -->
          <div class="flex items-start gap-4">
            <span
              class="numeral grid h-10 w-10 shrink-0 place-items-center rounded-pill bg-brand-ink font-display text-lg font-extrabold text-paper"
              aria-hidden="true"
            ></span>
            <div class="min-w-0">
              <h3 class="font-display text-lg font-bold leading-tight">{step.title}</h3>
              <p class="mt-2 text-ink-soft">{step.text}</p>
            </div>
            {step.icon && (
              <span class="ml-auto hidden h-10 w-10 shrink-0 place-items-center rounded-lg bg-paper-green text-brand-ink sm:grid">
                <Icon name={step.icon as never} size={20} />
              </span>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    counter-reset: step;
  }

  .steps > li {
    counter-increment: step;
  }

  /*
   * The numeral is generated, not typed. Reordering the steps in the CMS
   * renumbers them for free.
   */
  .steps .numeral::before {
    content: counter(step);
  }
</style>
