---
/* Lightweight inline-SVG icon set. Add new paths to `icons` as needed. */
interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className = '' } = Astro.props;

const icons = {
  instagram:
    '<rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none" />',
  facebook:
    '<path d="M14 9h3V5h-3a4 4 0 0 0-4 4v2H7v4h3v6h4v-6h3l1-4h-4V9a1 1 0 0 1 1-1Z" fill="currentColor" stroke="none" />',
  telegram:
    '<path d="M21 4 3 11l5 2 2 6 3-4 5 4 3-15Z" />',
  mastodon:
    '<path d="M19 13c0 4-3 5-7 5s-7-1-7-5V9a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v4Z" /><path d="M9 11v3M15 11v3" />',
  chevron: '<path d="m6 9 6 6 6-6" />',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6" />',
  menu: '<path d="M4 6h16M4 12h16M4 18h16" />',
  close: '<path d="M6 6l12 12M18 6 6 18" />',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />',
  phone:
    '<path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" />',
  clock: '<circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />',
  pin: '<path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" />',
  globe: '<circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18" />',
  search: '<circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />',
  user: '<circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />',
  check: '<path d="m4 12.5 5.5 5.5L20 6" />',
  leaf: '<path d="M4 20C4 11 11 4 20 4c0 9-7 16-16 16Z" /><path d="M4 20c4-4 7-6 12-8" />',
  heart: '<path d="M12 21S4 14.5 4 8.8A4.3 4.3 0 0 1 12 6a4.3 4.3 0 0 1 8 2.8C20 14.5 12 21 12 21Z" />',
  vote: '<path d="m9 12 2 2 4-4" /><rect x="3" y="4" width="18" height="16" rx="2" />',
  basket: '<path d="M3 8h18l-1.5 11a2 2 0 0 1-2 1.8H6.5a2 2 0 0 1-2-1.8L3 8Z" /><path d="M8 8 12 3l4 5" />',

  /*
   * --- Product and document vocabulary --------------------------------------
   *
   * The set above is a generic UI kit, and it was being stretched to label
   * things it cannot describe: /productes labelled `Làctics i ous` with a
   * heart, `Begudes` with a checkbox, `Forn i esmorzars` with a clock and
   * `Cura i llar` with a person. An icon that does not depict its label is
   * worse than no icon — it makes the reader stop and work out the metaphor.
   *
   * Drawn on the same 24×24 grid, same 2px round-capped stroke, so they sit
   * with the rest of the set.
   */
  apple:
    '<path d="M12 8.6c-1.1-1.5-2.9-2.1-4.4-1.3C5.5 8.4 4.8 11.3 5.8 14.4c.8 2.5 2.3 4.6 3.8 4.6.8 0 1.5-.4 2.4-.4s1.6.4 2.4.4c1.5 0 3-2.1 3.8-4.6 1-3.1.3-6-1.8-7.1-1.5-.8-3.3-.2-4.4 1.3Z" /><path d="M12 8.6V6.4A2.4 2.4 0 0 1 14.4 4h1.2" />',
  jar: '<path d="M6 3.5h12V7H6z" /><path d="M7.5 7h9v11.5a2.5 2.5 0 0 1-2.5 2.5h-4a2.5 2.5 0 0 1-2.5-2.5V7Z" /><path d="M7.5 12.5h9" />',
  milk: '<path d="M7 9.5 12 3l5 6.5V19a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V9.5Z" /><path d="M7 9.5h10" />',
  bread:
    '<path d="M4.5 13.2c0-3.4 3.4-5.7 7.5-5.7s7.5 2.3 7.5 5.7V16a2.5 2.5 0 0 1-2.5 2.5h-10A2.5 2.5 0 0 1 4.5 16v-2.8Z" /><path d="M9.2 8 7.7 13M12.6 7.6 11.1 13M16 8.4 14.5 13" />',
  bottle:
    '<path d="M10.2 3h3.6v3.2l1.5 2.3a4 4 0 0 1 .7 2.2V19a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-8.3a4 4 0 0 1 .7-2.2l1.5-2.3V3Z" /><path d="M8 14h8" />',
  soap: '<path d="M9.5 9h5a2.5 2.5 0 0 1 2.5 2.5v7A2.5 2.5 0 0 1 14.5 21h-5A2.5 2.5 0 0 1 7 18.5v-7A2.5 2.5 0 0 1 9.5 9Z" /><path d="M10 9V6.5h4V9" /><path d="M14 6.5V5a2 2 0 0 1 2-2h1.5" /><path d="M7 13.5h10" />',
  doc: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" /><path d="M14 3v5h5" /><path d="M9 13h6M9 17h4" />',
  chart: '<path d="M4 20h16" /><path d="M7.5 20v-5M12 20V8.5M16.5 20v-8" />',
  scale: '<path d="M12 4.5v15M8 19.5h8" /><path d="M4.5 8h15" /><path d="m4.5 8-2.5 5.5h5L4.5 8Z" /><path d="m19.5 8-2.5 5.5h5L19.5 8Z" />',
} as const;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={icons[name]}
/>
