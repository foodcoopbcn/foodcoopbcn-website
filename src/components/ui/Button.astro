---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'accent' | 'bare';
  size?: 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
  [key: string]: unknown;
}
const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  type = 'button',
  ...rest
} = Astro.props;

/*
 * `focus-visible:outline-none` used to sit here with nothing replacing it, which
 * silently removed the focus indicator from every button on the site — no hero
 * CTA, no form submit was reachable-looking by keyboard. The ring below works on
 * both light and green backgrounds thanks to the offset.
 */
const base =
  'inline-flex items-center justify-center gap-2 font-display font-extrabold tracking-tight rounded-pill transition-[color,background-color,box-shadow,translate] duration-[var(--duration-fast)] ease-out-soft active:translate-y-px focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand/40 focus-visible:ring-offset-2 focus-visible:ring-offset-transparent';
const sizes = {
  md: 'px-5 py-2.5 text-[0.95rem]',
  lg: 'px-7 py-3.5 text-lg',
};
/*
 * `primary` fills with brand-ink, not brand: white on #009739 is 3.83:1, which
 * fails AA at the default button size. Hover is a defined colour rather than a
 * brightness() filter, which behaved differently per variant.
 */
const variants = {
  primary: 'bg-brand-fill text-paper hover:bg-brand-hover shadow-sm',
  accent: 'bg-accent text-on-accent hover:bg-accent-hover shadow-sm',
  secondary: 'bg-ink text-paper hover:bg-brand-fill',
  ghost: 'bg-transparent text-ink ring-1 ring-ink/40 hover:ring-brand-ink hover:text-brand-ink',
  /*
   * No colours at all, for callers that supply their own — the hero's outline
   * CTA sits on a photograph and needs the on-ink ramp, not a theme colour.
   *
   * Without this they passed `text-on-ink-strong` in `class` while the variant
   * still emitted `text-paper`. Both are single-class rules, so the winner is
   * decided by order in the stylesheet, not order in the attribute. In one theme
   * the two were near-identical whites and the clash was invisible; the moment
   * --color-paper flipped dark, the button turned near-black on a dark band.
   */
  bare: '',
};
const cls = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
const Tag = href ? 'a' : 'button';
---
<Tag class={cls} href={href} type={href ? undefined : type} {...rest}>
  <slot />
</Tag>
