---
/*
 * Language switch, built as a segmented control over every locale the site is
 * built in — it reads `languages` from src/i18n/ui.ts, so adding English makes
 * a third segment appear with no change here.
 *
 * The version it replaces showed a single link with the *target* code, which
 * works for exactly two languages and becomes ambiguous the moment there is a
 * third: "CA · ES" gave no clue which one you were reading.
 *
 * The active locale is rendered as plain text with aria-current, not as a link
 * to itself. Destinations resolve through `alternateOf`, the same lookup the
 * hreflang tags use, because blog slugs differ per language and mirroring the
 * path there produces a 404.
 */
import { getLang, otherLangs, localizePath, stripLocale, allLangs } from '../../i18n/utils';
import { languages } from '../../i18n/ui';
import { alternateOf } from '../../lib/posts';

const lang = getLang(Astro.currentLocale);
const canonicalPath = stripLocale(Astro.url.pathname);

/* Nothing to translate on the 404, and Astro emits the default one as
   /404.html rather than /404/, so mirroring the path would link to a 404. */
const isNotFound = canonicalPath.replace(/\/$/, '') === '/404';

const targets = await Promise.all(
  otherLangs(lang).map(async (target) => {
    const mirrored = isNotFound
      ? localizePath('/', target)
      : localizePath(canonicalPath, target);
    const resolved = await alternateOf(Astro.url.pathname, mirrored);
    return {
      lang: target,
      /* No translated post: that language's news index is the closest honest
         destination, and it is never a broken link. */
      href: resolved ?? localizePath('/actualitat', target),
      name: languages[target],
    };
  }),
);

const label = { ca: 'Idioma', es: 'Idioma' }[lang] ?? 'Idioma';
const seeIn = {
  ca: (name: string) => `Veure aquesta pàgina en ${name.toLowerCase()}`,
  es: (name: string) => `Ver esta página en ${name.toLowerCase()}`,
}[lang];

const segment = 'px-2.5 py-1 text-sm font-bold uppercase leading-none transition-colors';
---
<div
  class="inline-flex items-center overflow-hidden rounded-md ring-1 ring-ink/20"
  role="group"
  aria-label={label}
>
  {
    allLangs.map((code) => {
      const target = targets.find((t) => t.lang === code);
      return target ? (
        <a
          href={target.href}
          hreflang={code}
          lang={code}
          title={seeIn(target.name)}
          class:list={[segment, 'text-ink-soft hover:bg-paper-soft hover:text-brand-ink']}
        >
          {code}
        </a>
      ) : (
        <span aria-current="true" class:list={[segment, 'bg-brand-ink text-paper']}>
          {code}
        </span>
      );
    })
  }
</div>
