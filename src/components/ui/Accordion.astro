---
/*
 * Disclosure built on <details> — no JavaScript, works with the keyboard for free.
 *
 * The question is wrapped in a real heading so FAQ pages contribute to the
 * document outline (search engines and screen-reader "list headings" both use
 * it); `id` puts an anchor on the item so a single answer can be linked to.
 */
import Icon from './Icon.astro';
interface Props {
  question: string;
  open?: boolean;
  /** Anchor target, so /faqs#quant-costa-fer-se-socia works. */
  id?: string;
  /** Heading level for the question. Match the surrounding outline. */
  as?: 'h2' | 'h3' | 'h4';
}
const { question, open = false, id, as: Heading = 'h3' } = Astro.props;
---
<details id={id} class="group border-b border-line py-1 [&[open]>summary_svg]:rotate-180" open={open}>
  <summary
    class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 transition-colors duration-[var(--duration-fast)] ease-out-soft hover:text-brand-ink marker:hidden"
  >
    <Heading class="font-display text-lg font-bold">{question}</Heading>
    <Icon
      name="chevron"
      class="shrink-0 text-brand-ink transition-transform duration-[var(--duration-base)] ease-out-soft"
    />
  </summary>
  <div class="reveal-panel prose-content pb-5 text-ink-soft">
    <slot />
  </div>
</details>

<style>
  /* Safari still paints its own disclosure triangle without this. */
  summary::-webkit-details-marker {
    display: none;
  }

  /*
   * The chevron used to rotate over a hard cut: the panel itself appeared
   * instantly. `@starting-style` gives the answer a real entrance without any
   * JavaScript and without measuring heights — the panel is display:none until
   * the details opens, so `transition-behavior: allow-discrete` is what makes
   * the frame before it become animatable.
   */
  @media (prefers-reduced-motion: no-preference) {
    .reveal-panel {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity var(--duration-base) var(--ease-out-soft),
        translate var(--duration-base) var(--ease-out-soft);
    }

    @starting-style {
      details[open] .reveal-panel {
        opacity: 0;
        translate: 0 -0.5rem;
      }
    }
  }
</style>
